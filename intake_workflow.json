    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "=Не смог надёжно прочитать накладную. {{ $json.badMath > 0 ? 'Не сходится количество x цена в строках: ' + $json.badNames + '. ' : '' }}Сфотографируйте бланк ровно, без бликов и складок, и отправьте ещё раз.",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "name": "Не разобрал",
