    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH inv AS (INSERT INTO invoices (chat_id, raw) VALUES ($1, $2::jsonb) RETURNING id), ins AS (INSERT INTO invoice_lines (invoice_id, name, qty, unit, price, line_sum) SELECT inv.id, x.name, x.qty, x.unit, x.price, x.line_sum FROM inv, jsonb_to_recordset($2::jsonb) AS x(name text, qty numeric, unit text, price numeric, line_sum numeric) RETURNING invoice_id) SELECT inv.id AS invoice_id, (SELECT count(*) FROM ins) AS saved FROM inv;",
        "options": {
          "queryReplacement": "={{ [ $('Telegram Trigger').item.json.message.chat.id, JSON.stringify($json.rows) ] }}"
        }
      },
      "name": "Записать накладную",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1680,
        100
      ],
      "id": "11b36d37-2901-56a4-bdb9-216f220ef599",
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Intake PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT l.name, l.qty, l.price, p.price_agreed, p.qty_expected, round((l.price - p.price_agreed) / NULLIF(p.price_agreed, 0) * 100, 1) AS price_dev_pct, (p.qty_expected - l.qty) AS short_qty, (l.price > p.price_agreed * (1 + p.tolerance_pct / 100)) AS price_bad, (l.qty < p.qty_expected) AS qty_bad FROM invoice_lines l LEFT JOIN price_list p ON lower(p.name) = lower(l.name) WHERE l.invoice_id = $1 ORDER BY l.id;",
        "options": {
          "queryReplacement": "={{ [ $json.invoice_id ] }}"
        }
      },
      "name": "Найти отклонения",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1920,
        100
      ],
      "id": "3da61968-fa89-585f-a401-98f4befe411d",
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Intake PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Сведение строк в один сигнал: красный, если есть отклонение цены, недовоз или товар не из прайса.\nconst rows = $input.all().map((i) => i.json);\nconst lines = [];\nlet red = false;\nfor (const r of rows) {\n  if (r.price_agreed === null || r.price_agreed === undefined) { red = true; lines.push(r.name + ': нет в прайсе'); continue; }\n  if (r.price_bad) { red = true; lines.push(r.name + ': цена ' + r.price + ' против ' + r.price_agreed + ' (' + (Number(r.price_dev_pct) > 0 ? '+' : '') + r.price_dev_pct + '%)'); }\n  if (r.qty_bad) { red = true; lines.push(r.name + ': привезли ' + r.qty + ', по заказу ' + r.qty_expected + ' (недовоз ' + r.short_qty + ')'); }\n}\nreturn [{ json: { invoice_id: $('Записать накладную').first().json.invoice_id, red, report: lines.join('\\n'), checked: rows.length } }];"
      },
      "name": "Свести сигнал",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        100
      ],
      "id": "5a3027ba-94ad-50dc-aa7f-d4f736297004",
      "notes": "Why Code: свод нескольких строк результата запроса в один красный или зелёный сигнал с текстом отчёта."
    },
